package-as: Atlas_Transportation

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain
    
enable-nolib-creation: no

# configs for WowInterface
wowi-archive-previous: yes
wowi-create-changelog: no

ignore:
    - Images/PSD
    - Images/TransAllianceStormwindCity/PSD
    - Images/TransHordeOrgrimmar/PSD
    - Images/TransAllianceBrokenIsles/PSD
    - Images/TransHordeBrokenIsles/PSD
    - Images/TransSuramar/PSD
